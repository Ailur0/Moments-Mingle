# Google AI API Key for activity suggestions
NEXT_PUBLIC_GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Instructions:
# 1. Get your Google AI API key from https://makersuite.google.com/app/apikey
# 2. Copy this file to .env.local
# 3. Replace 'your_google_ai_api_key_here' with your actual API key

# MongoDB connection string (for Atlas or cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# For MongoDB Community Edition (local):
MONGODB_URI=mongodb://localhost:27017/moments-mingle